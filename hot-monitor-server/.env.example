# 本地开发默认配置。启动服务前请将此文件复制为 .env。
NODE_ENV=development
PORT=3000

# PostgreSQL 运行在本机。请使用以下命令创建一次数据库：
#   psql -U postgres -c "CREATE DATABASE hot_monitor;"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hot_monitor?schema=public

# setup-local.ps1 创建 .env 时会将此值替换为随机密钥。
SESSION_SECRET=replace-me-local-session-secret
SESSION_COOKIE_NAME=hm.sid
# HMAC Bearer access tokens returned by login/register.
AUTH_TOKEN_SECRET=replace-with-a-long-random-auth-token-secret
AUTH_TOKEN_TTL_SECONDS=3600
CORS_ORIGIN=http://localhost:5173

# 在获得 OpenAI 兼容密钥前请保留占位值。替换被 Git 忽略的 .env 文件中的此值前，
# AI 分析调用将保持不可用。
OPENAI_API_KEY=replace-with-openai-compatible-api-key
OPENAI_BASE_URL=https://llmapi.xfcxb.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Hot-item automatic AI analysis is opt-in. Both this deployment guard and
# the authenticated runtime setting must be enabled before collection calls AI.
HOT_ITEM_AI_ALLOWED=false

# AI 生图供应商（服务端专用，禁止提交真实值；与 OPENAI_* 文本分析配置相互独立）
IMAGE_GENERATION_ENABLED=false
IMAGE_API_KEY=replace-with-image-provider-key
IMAGE_BASE_URL=https://image-provider.example/v1
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_MS=60000
IMAGE_MAX_RETRIES=1
IMAGE_MAX_N=4
IMAGE_ALLOWED_SIZES=1024x1024,1536x1024,1024x1536
COLLECTOR_INTERVAL_MINUTES=5
